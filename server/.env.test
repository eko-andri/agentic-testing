# =============================================================================
# TEST ENVIRONMENT - MULTI-PLATFORM LLM CONFIGURATION
# =============================================================================
# This is a test file to demonstrate provider switching and fallback

# -----------------------------------------------------------------------------
# PRIMARY LLM PROVIDER SELECTION
# -----------------------------------------------------------------------------
# Test different providers by changing this value
LLM_PROVIDER=groq

# -----------------------------------------------------------------------------
# CLOUD PROVIDERS (For Testing)
# -----------------------------------------------------------------------------

# Groq Cloud - Uncomment to test
# GROQ_API_KEY=gsk_test_key_here
GROQ_MODEL=qwen3:30b

# OpenAI - Uncomment to test
# OPENAI_API_KEY=sk-test_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude - Uncomment to test
# ANTHROPIC_API_KEY=sk-ant-test_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# AWS Bedrock - Uncomment to test
# AWS_ACCESS_KEY_ID=your_aws_access_key_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-3-haiku-20240307-v1:0

# -----------------------------------------------------------------------------
# LOCAL PROVIDER (Always Available)
# -----------------------------------------------------------------------------

# Ollama (Local fallback - should always work)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# -----------------------------------------------------------------------------
# PERFORMANCE TUNING
# -----------------------------------------------------------------------------

MAX_TOKENS=4000
CLOUD_LLM_TIMEOUT=120000
OLLAMA_TIMEOUT=180000
OLLAMA_LARGE_TIMEOUT=600000

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------

PORT=3333
NODE_ENV=development
DEBUG=false
