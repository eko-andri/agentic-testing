# Agentic Testing Server Configuration

# LLM Provider Configuration
# Options: ollama, bedrock
LLM_PROVIDER=bedrock

# For Ollama (if using local Ollama)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen3:30b

# For AWS Bedrock (if using AWS Bedrock)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=ap-southeast-1

# Server Configuration
PORT=3333

# Supported Models:
# Ollama: qwen3:30b, llama3, codellama, etc.
# Bedrock: anthropic.claude-3-sonnet-20240229-v1:0, anthropic.claude-3-haiku-20240307-v1:0, etc.
