# =============================================================================
# AGENTIC TESTING - MULTI-PLATFORM LLM CONFIGURATION
# =============================================================================
# This file configures the agentic testing system with multiple LLM providers
# for flexible cloud-first deployment with local fallback capabilities.

# -----------------------------------------------------------------------------
# PRIMARY LLM PROVIDER SELECTION
# -----------------------------------------------------------------------------
# Available options: groq, openai, anthropic, ollama, bedrock
# The system will automatically fallback to Ollama if primary provider fails
LLM_PROVIDER=groq

# Override default model for current provider (optional)
# LLM_MODEL=qwen3:8b

# -----------------------------------------------------------------------------
# CLOUD PROVIDERS (Primary Options)
# -----------------------------------------------------------------------------

# Groq Cloud (Recommended - Fast inference)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen3:30b

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-haiku-20240307

# AWS Bedrock
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_SESSION_TOKEN=your_aws_session_token_here
AWS_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-3-haiku-20240307-v1:0

# -----------------------------------------------------------------------------
# LOCAL PROVIDER (Fallback)
# -----------------------------------------------------------------------------

# Ollama (Local fallback - always available)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# -----------------------------------------------------------------------------
# LLM PERFORMANCE TUNING
# -----------------------------------------------------------------------------

# Token limits
MAX_TOKENS=4000

# Timeout settings (milliseconds)
CLOUD_LLM_TIMEOUT=120000
OLLAMA_TIMEOUT=180000
OLLAMA_LARGE_TIMEOUT=600000

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------

# Server port
PORT=3333

# Test execution
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_RETRIES=1

# Development mode
NODE_ENV=development
DEBUG=false

# -----------------------------------------------------------------------------
# PROVIDER-SPECIFIC NOTES
# -----------------------------------------------------------------------------

# Groq Models (Recommended):
# - qwen3:8b (Fast, efficient for most tasks)
# - qwen3:30b (High quality, slower)
# - llama3-8b-8192 (Alternative option)

# OpenAI Models:
# - gpt-4o-mini (Cost-effective)
# - gpt-4o (High quality, expensive)
# - gpt-3.5-turbo (Budget option)

# Anthropic Models:
# - claude-3-haiku-20240307 (Fast, cost-effective)
# - claude-3-sonnet-20240229 (Balanced)
# - claude-3-opus-20240229 (Highest quality)

# Ollama Models (Local):
# - qwen3:8b (Recommended for local testing)
# - qwen3:30b (High quality, requires 16GB+ RAM)
# - llama3:8b (Alternative option)
# - codellama:7b (Code-focused)

# Bedrock Models:
# - us.anthropic.claude-3-haiku-20240307-v1:0
# - us.anthropic.claude-3-sonnet-20240229-v1:0
# - us.anthropic.claude-3-opus-20240229-v1:0

# =============================================================================
# QUICK SETUP INSTRUCTIONS
# =============================================================================

# 1. Copy this file to .env: cp .env.example .env
# 2. Add your API keys for desired providers
# 3. Set LLM_PROVIDER to your primary choice
# 4. Install Ollama for fallback: https://ollama.com/download
# 5. Pull Ollama model: ollama pull qwen3:8b
# 6. Run system: npm start

# Cost Optimization Tips:
# - Use Groq for cost-effective cloud deployment
# - Use Ollama for development and testing
# - Set appropriate token limits and timeouts
# - Monitor usage with smaller models first
